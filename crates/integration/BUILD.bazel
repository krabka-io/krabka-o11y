load("//bazel:defs.bzl", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "integration")

crate_tests(
    # The Prometheus TSDB block that `backup_restore` uploads before the cut.
    data = ["//crates/metrics:tsdb_fixture"],
    docker = {
        "alloy_client": ["alloy"],
        "prometheus_client": ["prometheus"],
        # The operating-envelope soak. Every signal writes and reads through
        # this one MinIO, so the request counts it reports are the counts a
        # real object store would bill.
        "soak_envelope": ["minio"],
    },
    docker_variants = {
        "alloy_client": {"previous": {"alloy": "alloy_previous"}},
        "prometheus_client": {"previous": {"prometheus": "prometheus_previous"}},
    },
    # `backup_restore` reaches the fixture reader of //crates/metrics with
    # `#[path]`; naming it here puts it at that same relative path inside the
    # sandbox.
    extra_srcs = {
        "backup_restore": ["//crates/metrics:tests/support/tsdb_fixture.rs"],
    },
    lib = "integration",
    # The library holds no code to mutate -- it is the `//!` doc that says why
    # this crate is allowed to depend on more than one signal. A sweep over it
    # would generate no mutants and report on nothing.
    mutants = False,
    # The soak holds a wall-clock budget of several minutes per run. The
    # `scale` tag keeps it out of `bazel test //...` and out of the nightly
    # container job. //.bazelrc selects it with `--config=scale`, and the
    # `scale` job in //.github/workflows/ci.yml runs that on a schedule.
    scale = ["soak_envelope"],
)
