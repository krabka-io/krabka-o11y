load("//bazel:defs.bzl", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

# `experimental-functions` is off by default, so the default build never
# compiles the code behind it: `limitk`, `limit_ratio`,
# `double_exponential_smoothing`, the `histogram_quantiles` family, the duration
# helpers and the query-range context they read. The conformance suite selects
# its corpus by the same `cfg!`, so `limit.test` is skipped as well. Building
# and testing a second copy with the feature on is what puts any of that under
# CI; the two configurations coexist in this package under `_experimental`
# target names.
EXPERIMENTAL = {"experimental": ["experimental-functions"]}

crate_library(
    name = "promql",
    feature_variants = EXPERIMENTAL,
)

crate_tests(
    data = glob(["tests/testdata/**"]),
    feature_variants = EXPERIMENTAL,
    lib = "promql",
    # The sweep rebuilds the crate once per mutant, so a shard's wall clock is
    # crate size times mutants-per-shard. At the default `long` (900s) every
    # shard here was killed mid-sweep -- and a killed shard reports nothing
    # rather than failing, so eight crates read as "0 mutants, 0 missed" when
    # they had simply never finished. pprof alone needs 2628s.
    # `eternal` is the largest category Bazel offers but it is only 3600s, not
    # unlimited, and the larger crates run past that too. Going beyond an hour
    # needs --test_timeout on the command line, which overrides the category;
    # the sweep script passes it.
    # One cargo job per shard. Bazel already runs the shards concurrently, so
    # the default of 4 multiplied out to shards x 4 concurrent cargo builds --
    # 48 on a 32-core machine, which drove load average past 200 and made every
    # shard miss its deadline for want of CPU rather than for want of time.
    mutants_jobs = 1,
    mutants_shards = 32,
    mutants_timeout = "eternal",
    # Sweep the variant, not the default build. Fifteen of this crate's unit
    # tests sit behind `experimental-functions`, so a default-feature sweep
    # compiles both the code and the tests that cover it out and reports every
    # mutant in it as a survivor -- twenty-two in `double_exponential_smoothing`
    # alone read that way.
    mutants_variant = "experimental",
    no_harness = ["conformance"],
)
