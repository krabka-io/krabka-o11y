load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
# `tests/support/lifecycle_store.rs` opens the store a signal's lifecycle suite
# runs against, and `tests/support/hooked_store.rs` is the in-memory store the
# traces and profiles suites inject faults through. `tests/support/flaky_put_store.rs`
# wraps it in a store whose first puts fail, for the block writer's and the
# metrics compactor's unit tests. The signal crates reach them with `#[path]`,
# so they have to be nameable from there.
exports_files([
    "Cargo.toml",
    "tests/support/flaky_put_store.rs",
    "tests/support/hooked_store.rs",
    "tests/support/lifecycle_store.rs",
])

crate_library(
    name = "blockstore",
    # The writer's unit tests reach the flaky object store, which is shared
    # with //crates/metrics, with `#[path]`.
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ) + [
        "tests/support/flaky_put_store.rs",
        "tests/support/hooked_store.rs",
    ],
)

crate_binary(
    name = "krabka-storage-admin",
    crate_root = "src/bin/krabka-storage-admin/main.rs",
    lib = ":blockstore",
)

crate_tests(
    lib = "blockstore",
    manual = ["object_store_provider_contract"],
    # The sweep rebuilds the crate once per mutant, so a shard's wall clock is
    # crate size times mutants-per-shard. At the default `long` (900s) every
    # shard here was killed mid-sweep -- and a killed shard reports nothing
    # rather than failing, so eight crates read as "0 mutants, 0 missed" when
    # they had simply never finished. pprof alone needs 2628s.
    # `eternal` is the largest category Bazel offers but it is only 3600s, not
    # unlimited, and the larger crates run past that too. Going beyond an hour
    # needs --test_timeout on the command line, which overrides the category;
    # the sweep script passes it.
    # One cargo job per shard. Bazel already runs the shards concurrently, so
    # the default of 4 multiplied out to shards x 4 concurrent cargo builds --
    # 48 on a 32-core machine, which drove load average past 200 and made every
    # shard miss its deadline for want of CPU rather than for want of time.
    mutants_jobs = 1,
    # The reviewed baseline in
    # qualification/milestone-19-mutation-baselines.json came from a
    # 24-shard run. tools/mutants-record.py --check fails when the record
    # and this number differ, so change both together.
    mutants_shards = 24,
    mutants_timeout = "eternal",
)
