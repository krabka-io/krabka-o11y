# Exact metrics over the shared seven-span fixture, not engine snapshots.
# Inclusive range start=0/end=10000/step=10000 emits points at 0 and 10000ns.
# Nonfinite values use explicit JSON strings "NaN", "+Inf", "-Inf"; null is distinct.
# Every span starts at 1001..1004ns: all values are in the first bucket.
# Counts by span.svc: a=2, b=2, c=1, d=1, x=1. No exemplars by default.
# Rate divides each count by 0.00001 seconds (IEEE-754 values below).
# Sorted durations: [50,80,100,100,100,200,220]ns, sum=850ns.
# Tempo log2 buckets: 64ns=1, 128ns=4, 256ns=2, expressed in seconds.
# Quantiles consume ceil(q*7) observations: p50 interpolates 3/4 of
# the 64..128ns logarithmic interval; p90 and p99 select 256ns.
# Ranking ties use ascending labels: top2=a,b; bottom1=c.

name: metrics_rate_single_series
kind: metrics
query: { .svc != nil } | rate()
expect_series_count: 1
expect_metrics: [{"labels":[],"points":[[0,700000.0],[10000,0.0]],"exemplars":[]}]

---
name: metrics_rate_by_svc
kind: metrics
query: { .svc != nil } | rate() | by(span.svc)
expect_series_count: 5
expect_metrics: [{"labels":[["span.svc","a"]],"points":[[0,199999.99999999997],[10000,0.0]],"exemplars":[]},{"labels":[["span.svc","b"]],"points":[[0,199999.99999999997],[10000,0.0]],"exemplars":[]},{"labels":[["span.svc","c"]],"points":[[0,99999.99999999999],[10000,0.0]],"exemplars":[]},{"labels":[["span.svc","d"]],"points":[[0,99999.99999999999],[10000,0.0]],"exemplars":[]},{"labels":[["span.svc","x"]],"points":[[0,99999.99999999999],[10000,0.0]],"exemplars":[]}]

---
name: metrics_count_over_time_single_series
kind: metrics
query: { .svc != nil } | count_over_time()
expect_series_count: 1
expect_metrics: [{"labels":[],"points":[[0,7.0],[10000,0.0]],"exemplars":[]}]

---
name: metrics_count_over_time_by_svc
kind: metrics
query: { .svc != nil } | count_over_time() | by(span.svc)
expect_series_count: 5
expect_metrics: [{"labels":[["span.svc","a"]],"points":[[0,2.0],[10000,0.0]],"exemplars":[]},{"labels":[["span.svc","b"]],"points":[[0,2.0],[10000,0.0]],"exemplars":[]},{"labels":[["span.svc","c"]],"points":[[0,1.0],[10000,0.0]],"exemplars":[]},{"labels":[["span.svc","d"]],"points":[[0,1.0],[10000,0.0]],"exemplars":[]},{"labels":[["span.svc","x"]],"points":[[0,1.0],[10000,0.0]],"exemplars":[]}]

---
name: metrics_quantile_over_time_one_quantile
kind: metrics
query: { .svc != nil } | quantile_over_time(span:duration, .99)
expect_series_count: 1
expect_metrics: [{"labels":[["p","0.99"]],"points":[[0,2.56e-07],[10000,0.0]],"exemplars":[]}]

---
name: metrics_quantile_over_time_three_quantiles
kind: metrics
query: { .svc != nil } | quantile_over_time(span:duration, .5, .9, .99)
expect_series_count: 3
expect_metrics: [{"labels":[["p","0.5"]],"points":[[0,1.0763474115247534e-07],[10000,0.0]],"exemplars":[]},{"labels":[["p","0.9"]],"points":[[0,2.56e-07],[10000,0.0]],"exemplars":[]},{"labels":[["p","0.99"]],"points":[[0,2.56e-07],[10000,0.0]],"exemplars":[]}]

---
name: metrics_histogram_over_time_default_field
kind: metrics
query: { .svc != nil } | histogram_over_time()
expect_series_count: 3
expect_metrics: [{"labels":[["__bucket","0.000000064"]],"points":[[0,1.0],[10000,0.0]],"exemplars":[]},{"labels":[["__bucket","0.000000128"]],"points":[[0,4.0],[10000,0.0]],"exemplars":[]},{"labels":[["__bucket","0.000000256"]],"points":[[0,2.0],[10000,0.0]],"exemplars":[]}]

---
name: metrics_histogram_over_time_explicit_field
kind: metrics
query: { .svc != nil } | histogram_over_time(span:duration)
expect_series_count: 3
expect_metrics: [{"labels":[["__bucket","0.000000064"]],"points":[[0,1.0],[10000,0.0]],"exemplars":[]},{"labels":[["__bucket","0.000000128"]],"points":[[0,4.0],[10000,0.0]],"exemplars":[]},{"labels":[["__bucket","0.000000256"]],"points":[[0,2.0],[10000,0.0]],"exemplars":[]}]

---
# Tempo attribute-comparison compare(): outer `{ .svc = "x" }` matches the one
# "both" span (svc=x, a=1, b=2, name attr=xpost, resource service-name=svc-x);
# no span has status=error so the selection group is empty. The 8 distinct
# attribute values — span.svc, span.a, span.b, span.name, resource.service.name,
# plus the name/status/kind intrinsics — form one shared value set, and EACH
# value emits both a baseline and a (zero-filled) selection series so the two
# groups cover the same values = 16, plus the two per-group total series = 18.
name: metrics_compare_attribute_distribution
kind: metrics
query: { .svc = "x" } | compare({ status = error }, 10)
expect_series_count: 18
expect_metrics: [{"labels":[["__meta_type","baseline"],["kind","unspecified"]],"points":[[0,1.0],[10000,0.0]],"exemplars":[]},{"labels":[["__meta_type","selection"],["kind","unspecified"]],"points":[[0,0.0],[10000,0.0]],"exemplars":[]},{"labels":[["__meta_type","baseline"],["name","both"]],"points":[[0,1.0],[10000,0.0]],"exemplars":[]},{"labels":[["__meta_type","selection"],["name","both"]],"points":[[0,0.0],[10000,0.0]],"exemplars":[]},{"labels":[["__meta_type","baseline"],["resource.service.name","svc-x"]],"points":[[0,1.0],[10000,0.0]],"exemplars":[]},{"labels":[["__meta_type","selection"],["resource.service.name","svc-x"]],"points":[[0,0.0],[10000,0.0]],"exemplars":[]},{"labels":[["__meta_type","baseline"],["span.a","1"]],"points":[[0,1.0],[10000,0.0]],"exemplars":[]},{"labels":[["__meta_type","selection"],["span.a","1"]],"points":[[0,0.0],[10000,0.0]],"exemplars":[]},{"labels":[["__meta_type","baseline"],["span.b","2"]],"points":[[0,1.0],[10000,0.0]],"exemplars":[]},{"labels":[["__meta_type","selection"],["span.b","2"]],"points":[[0,0.0],[10000,0.0]],"exemplars":[]},{"labels":[["__meta_type","baseline"],["span.name","xpost"]],"points":[[0,1.0],[10000,0.0]],"exemplars":[]},{"labels":[["__meta_type","selection"],["span.name","xpost"]],"points":[[0,0.0],[10000,0.0]],"exemplars":[]},{"labels":[["__meta_type","baseline"],["span.svc","x"]],"points":[[0,1.0],[10000,0.0]],"exemplars":[]},{"labels":[["__meta_type","selection"],["span.svc","x"]],"points":[[0,0.0],[10000,0.0]],"exemplars":[]},{"labels":[["__meta_type","baseline"],["status","unset"]],"points":[[0,1.0],[10000,0.0]],"exemplars":[]},{"labels":[["__meta_type","selection"],["status","unset"]],"points":[[0,0.0],[10000,0.0]],"exemplars":[]},{"labels":[["__meta_type","baseline_total"]],"points":[[0,1.0],[10000,0.0]],"exemplars":[]},{"labels":[["__meta_type","selection_total"]],"points":[[0,0.0],[10000,0.0]],"exemplars":[]}]

---
name: metrics_topk_truncates_groups
kind: metrics
query: { .svc != nil } | count_over_time() | by(span.svc) | topk(2)
expect_series_count: 2
expect_metrics: [{"labels":[["span.svc","a"]],"points":[[0,2.0],[10000,0.0]],"exemplars":[]},{"labels":[["span.svc","b"]],"points":[[0,2.0],[10000,0.0]],"exemplars":[]}]

---
name: metrics_topk_above_group_count
kind: metrics
query: { .svc != nil } | count_over_time() | by(span.svc) | topk(10)
expect_series_count: 5
expect_metrics: [{"labels":[["span.svc","a"]],"points":[[0,2.0],[10000,0.0]],"exemplars":[]},{"labels":[["span.svc","b"]],"points":[[0,2.0],[10000,0.0]],"exemplars":[]},{"labels":[["span.svc","c"]],"points":[[0,1.0],[10000,0.0]],"exemplars":[]},{"labels":[["span.svc","d"]],"points":[[0,1.0],[10000,0.0]],"exemplars":[]},{"labels":[["span.svc","x"]],"points":[[0,1.0],[10000,0.0]],"exemplars":[]}]

---
name: metrics_bottomk_truncates_groups
kind: metrics
query: { .svc != nil } | count_over_time() | by(span.svc) | bottomk(1)
expect_series_count: 1
expect_metrics: [{"labels":[["span.svc","c"]],"points":[[0,1.0],[10000,0.0]],"exemplars":[]}]
