load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(
    name = "traces",
    # The metrics unit tests reach the pipeline-bundle checks every signal
    # shares with `#[path]` from //crates/observability.
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ) + ["//crates/observability:tests/support/pipeline_bundle_metrics.rs"],
    # `build.rs` generates prost types from these.
    build_script_data = glob(["proto/**"]),
)

# `bazel run //crates/traces:krabka-traces -- --help`.
crate_binary(
    name = "krabka-traces",
    crate_root = "src/bin/krabka-traces/main.rs",
    # Test helpers shared with the other signal binaries, reached with
    # `#[path]` from //crates/observability.
    extra_srcs = [
        "//crates/observability:tests/support/compaction_passes.rs",
        "//crates/observability:tests/support/in_process_broker.rs",
        "//crates/observability:tests/support/wal_fetch_limit_flags.rs",
    ],
    lib = ":traces",
)

crate_tests(
    # `traceql_conformance` runs the sibling crate's golden corpus through this
    # crate's engine, reaching it with a `..` path from the crate directory.
    data = ["//crates/traceql:corpus"],
    # Suites that drive a real Grafana-stack component and compare against
    # it, with the images each one starts. //bazel/images pins those by
    # digest and //bazel/defs.bzl loads them before the suite runs.
    docker = {
        "grafana_e2e": [
            "grafana",
            "prometheus",
        ],
        "tempo_deployment": [
            "krabka",
            "broker",
            "minio",
        ],
        "tempo_differential": [
            "grafana",
            "tempo",
        ],
    },
    docker_variants = {
        "grafana_e2e": {
            "previous": {
                "grafana": "grafana_previous",
                "prometheus": "prometheus",
            },
        },
        "tempo_differential": {
            "previous": {
                "grafana": "grafana_previous",
                "tempo": "tempo",
            },
        },
    },
    # The shared lifecycle and hooked stores, reached with `#[path]` from
    # //crates/blockstore, and the Jaeger thrift fixture the library's unit
    # tests also use.
    extra_srcs = {
        "block_lifecycle": ["//crates/blockstore:tests/support/lifecycle_store.rs"],
        "blockbuilder": ["//crates/blockstore:tests/support/hooked_store.rs"],
        "grafana_e2e": [
            "src/wire/jaeger/thrift_fixture.rs",
            "//crates/metrics-service:tests/support/pinned_grafana_image.rs",
        ],
        "index_shard_publication": ["//crates/blockstore:tests/support/hooked_store.rs"],
        "tempo_deployment": [
            "//crates/metrics-service:tests/support/container_deployment.rs",
            "//crates/metrics-service:tests/support/deployment_evidence.rs",
        ],
        "tempo_differential": ["//crates/metrics-service:tests/support/generated_differential.rs"],
        "tenant_isolation": ["src/wire/jaeger_grpc/post_spans_fixture.rs"],
    },
    lib = "traces",
    # The sweep rebuilds the crate once per mutant, so a shard's wall clock is
    # crate size times mutants-per-shard. At the default `long` (900s) every
    # shard here was killed mid-sweep -- and a killed shard reports nothing
    # rather than failing, so eight crates read as "0 mutants, 0 missed" when
    # they had simply never finished. pprof alone needs 2628s.
    # `eternal` is the largest category Bazel offers but it is only 3600s, not
    # unlimited, and the larger crates run past that too. Going beyond an hour
    # needs --test_timeout on the command line, which overrides the category;
    # the sweep script passes it.
    # One cargo job per shard. Bazel already runs the shards concurrently, so
    # the default of 4 multiplied out to shards x 4 concurrent cargo builds --
    # 48 on a 32-core machine, which drove load average past 200 and made every
    # shard miss its deadline for want of CPU rather than for want of time.
    mutants_jobs = 1,
    mutants_shards = 24,
    mutants_timeout = "eternal",
    no_harness = ["traceql_conformance"],
)
