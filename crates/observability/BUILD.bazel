load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "observability")

# `bazel run //crates/observability:krabka-observability -- --help`.
crate_binary(
    name = "krabka-observability",
    crate_root = "src/bin/krabka-observability/main.rs",
    lib = ":observability",
)

crate_tests(
    # `compactor` asserts on wall-clock behaviour: several cases wrap the
    # runtime in a one-second `tokio::time::timeout` and give it a 250ms retry
    # budget. That holds on an idle machine and does not under `bazel
    # coverage`, where instrumentation makes every action slower and the test
    # shares four cores with whatever else the invocation is still compiling --
    # `compactor_runtime_retries_shard_manifest_write_errors_before_committing_offsets`
    # timed out that way while the promql feature variant was building beside
    # it, having reached none of the assertions that would show a real fault.
    # `cpu:4` stops Bazel scheduling work alongside it, and the retry reports
    # FLAKY rather than passing a timing hiccup off as a clean run.
    cpu_heavy = ["compactor"],
    # The suites that drive a real container, with the image each one starts.
    # //bazel/images pins those by digest and //bazel/defs.bzl loads them
    # before the suite runs. `loki_differential` compares against a real
    # Grafana Loki; `scale_object_store` writes to a real MinIO, which is the
    # only way the request-shaped costs of an object store are exercised at
    # all -- an `InMemory` store answers every call from a map.
    docker = {
        "loki_differential": ["loki"],
        "scale_object_store": ["minio"],
        "soak_ingest_query": ["minio"],
    },
    lib = "observability",
    # The sweep rebuilds the crate once per mutant, so a shard's wall clock is
    # crate size times mutants-per-shard. At the default `long` (900s) every
    # shard here was killed mid-sweep -- and a killed shard reports nothing
    # rather than failing, so eight crates read as "0 mutants, 0 missed" when
    # they had simply never finished. pprof alone needs 2628s.
    # `eternal` is the largest category Bazel offers but it is only 3600s, not
    # unlimited, and the larger crates run past that too. Going beyond an hour
    # needs --test_timeout on the command line, which overrides the category;
    # the sweep script passes it.
    # One cargo job per shard. Bazel already runs the shards concurrently, so
    # the default of 4 multiplied out to shards x 4 concurrent cargo builds --
    # 48 on a 32-core machine, which drove load average past 200 and made every
    # shard miss its deadline for want of CPU rather than for want of time.
    mutants_jobs = 1,
    mutants_shards = 32,
    mutants_timeout = "eternal",
    # Ten thousand series, a million spans and a twenty-four block compaction,
    # against the MinIO above. The `scale` tag is what keeps this out of
    # `bazel test //...` and out of the nightly container job, both of which
    # have budgets this suite would take on its own. //.bazelrc selects it with
    # `--config=scale`, and the `scale` job in //.github/workflows/ci.yml runs
    # that on a schedule.
    scale = [
        "scale_object_store",
        "soak_ingest_query",
    ],
)
