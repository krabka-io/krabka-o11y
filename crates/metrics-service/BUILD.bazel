load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# The vendored Prometheus `promql/promqltest` corpus, which
# `tests/support/promql_corpus.rs` reads to build the differential corpus. It
# lives with //crates/promql, which runs the same files in process; naming every
# file here rather than globbing keeps the two suites' view of the corpus one
# list, and `promql_corpus` fails when the directory holds a `.test` file it does
# not name. Under Bazel that check sees only the files named here, so it catches
# a file this list has and Rust does not; the reverse -- a newly vendored file in
# neither -- is caught by the `cargo` lane, which reads the directory itself.
PROMQL_CORPUS = ["//crates/promql:tests/testdata/%s.test" % stem for stem in [
    "aggregators",
    "at_modifier",
    "collision",
    "duration_expression",
    "extended_vectors",
    "functions",
    "histograms",
    "info",
    "limit",
    "literals",
    "name_label_dropping",
    "native_histograms",
    "operators",
    "range_queries",
    "ranges",
    "selectors",
    "staleness",
    "subquery",
    "trig_functions",
    "type_and_unit",
]]

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "metrics-service")

# `bazel run //crates/metrics-service:krabka-metrics-service -- --help`.
crate_binary(
    name = "krabka-metrics-service",
    crate_root = "src/bin/krabka-metrics-service/main.rs",
    lib = ":metrics-service",
)

crate_tests(
    # The shipped clock rule bundle. `clock_rules_bundle` loads it from this
    # path and evaluates it, so the suite reads the file a deployment ships.
    data = ["rules/krabka-clock.yaml"] + PROMQL_CORPUS,
    # Suites that drive a real Grafana-stack component and compare against
    # it, with the images each one starts. //bazel/images pins those by
    # digest and //bazel/defs.bzl loads them before the suite runs.
    docker = {
        "diff_mimir": ["mimir"],
        "diff_prometheus": ["prometheus"],
        "grafana_integration": ["grafana"],
    },
    # The hand-written seed dataset lives with //crates/metrics and these suites
    # reach it with `#[path]`; naming it here puts it at that same relative
    # path inside the sandbox. The corpus-driven differential corpus is a
    # sibling of the suites themselves, under tests/support/, so `crate_tests`
    # picks it up as an ordinary helper module.
    extra_srcs = {
        stem: ["//crates/metrics:tests/support/diff_corpus.rs"]
        for stem in [
            "diff_mimir",
            "diff_prometheus",
            "grafana_integration",
        ]
    },
    lib = "metrics-service",
    # The sweep rebuilds the crate once per mutant, so a shard's wall clock is
    # crate size times mutants-per-shard. At the default `long` (900s) every
    # shard here was killed mid-sweep -- and a killed shard reports nothing
    # rather than failing, so eight crates read as "0 mutants, 0 missed" when
    # they had simply never finished. pprof alone needs 2628s.
    # `eternal` is the largest category Bazel offers but it is only 3600s, not
    # unlimited, and the larger crates run past that too. Going beyond an hour
    # needs --test_timeout on the command line, which overrides the category;
    # the sweep script passes it.
    # One cargo job per shard. Bazel already runs the shards concurrently, so
    # the default of 4 multiplied out to shards x 4 concurrent cargo builds --
    # 48 on a 32-core machine, which drove load average past 200 and made every
    # shard miss its deadline for want of CPU rather than for want of time.
    mutants_jobs = 1,
    mutants_shards = 8,
    mutants_timeout = "eternal",
)
