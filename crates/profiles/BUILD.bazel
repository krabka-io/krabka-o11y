load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(
    name = "profiles",
    # `build.rs` generates prost types from these.
    build_script_data = glob(["proto/**"]),
    # `src/ingest` reaches these with `include_bytes!`, so they are read while
    # the library compiles, not while a test runs.
    compile_data = glob(["tests/fixtures/**"]),
)

# `bazel run //crates/profiles:krabka-profiles -- --help`.
crate_binary(
    name = "krabka-profiles",
    crate_root = "src/bin/krabka-profiles/main.rs",
    lib = ":profiles",
)

crate_tests(
    compile_data = glob(["tests/fixtures/**"]),
    data = glob(["tests/fixtures/**"]),
    # Suites that drive a real Grafana-stack component and compare against
    # it, with the images each one starts. //bazel/images pins those by
    # digest and //bazel/defs.bzl loads them before the suite runs.
    docker = {
        "pyroscope_deployment": [
            "broker",
            "krabka",
            "minio",
        ],
        "pyroscope_differential": [
            "grafana",
            "pyroscope",
        ],
    },
    docker_variants = {
        "pyroscope_differential": {
            "previous": {
                "grafana": "grafana_previous",
                "pyroscope": "pyroscope",
            },
        },
    },
    # The shared lifecycle store, reached with `#[path]` from //crates/blockstore,
    # and the fixtures shared with the binary's own suites, reached with `#[path]`
    # from `src/bin/krabka-profiles`.
    extra_srcs = {
        "block_builder_drain": ["src/bin/krabka-profiles/wal_topic.rs"],
        "block_builder_object_store_retry": ["src/bin/krabka-profiles/wal_topic.rs"],
        "ingest_roundtrip": [
            "src/bin/krabka-profiles/render_roundtrip.rs",
            "src/bin/krabka-profiles/synthetic_cpu_profile.rs",
            "src/bin/krabka-profiles/wal_topic.rs",
        ],
        "lifecycle": ["//crates/blockstore:tests/support/lifecycle_store.rs"],
        "pyroscope_deployment": ["//crates/metrics-service:tests/support/container_deployment.rs"],
        "pyroscope_differential": [
            "//crates/metrics-service:tests/support/generated_differential.rs",
            "src/bin/krabka-profiles/synthetic_cpu_profile.rs",
        ],
    },
    lib = "profiles",
    # The sweep rebuilds the crate once per mutant, so a shard's wall clock is
    # crate size times mutants-per-shard. At the default `long` (900s) every
    # shard here was killed mid-sweep -- and a killed shard reports nothing
    # rather than failing, so eight crates read as "0 mutants, 0 missed" when
    # they had simply never finished. pprof alone needs 2628s.
    # `eternal` is the largest category Bazel offers but it is only 3600s, not
    # unlimited, and the larger crates run past that too. Going beyond an hour
    # needs --test_timeout on the command line, which overrides the category;
    # the sweep script passes it.
    # One cargo job per shard. Bazel already runs the shards concurrently, so
    # the default of 4 multiplied out to shards x 4 concurrent cargo builds --
    # 48 on a 32-core machine, which drove load average past 200 and made every
    # shard miss its deadline for want of CPU rather than for want of time.
    mutants_jobs = 1,
    mutants_shards = 16,
    mutants_timeout = "eternal",
)
