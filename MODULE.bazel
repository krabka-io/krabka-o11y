"""krabka-o11y — Bazel module (bzlmod).

Bazel is the build and test path; Cargo stays the dependency source of truth.
`crate.from_cargo` reads the same `Cargo.toml` / `Cargo.lock` that Cargo does,
so there is no second dependency set to keep in sync.
"""

module(
    name = "krabka_o11y",
    version = "0.4.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rs", version = "0.0.110")
bazel_dep(name = "rules_rs_mutants", version = "0.0.1")

# rules_rs_mutants is not published to the Bazel Central Registry, so the
# `bazel_dep` above has nothing to resolve against without this override.
git_override(
    module_name = "rules_rs_mutants",
    # Resolved to a commit so the checkout is reproducible. Past v0.0.1 for
    # `//mutants:config`, without which the sweep enumerates from a synthetic
    # workspace where this repo's `.cargo/mutants.toml` is not in scope -- so the
    # exclusions written there did not exclude.
    # Past the config fix for `integration_tests`, which reruns the suites under
    # tests/ against each mutant. Without it a crate whose coverage lives there
    # reports almost every mutant as missed: logql's syntax.rs showed 165
    # survivors on unit tests alone against 1 with the suites included.
    commit = "80120ba8d223abf1467f611e46c2969789e704fb",
    remote = "https://github.com/robot-head/rules_rs_mutants",
)

# A hermetic C++ toolchain rather than the host's.
#
# Bazel's autodetected toolchain links with whatever the machine happens to have.
# GitHub's runners carry `ld.gold`, so it passed `-fuse-ld=gold` and every link
# action printed "the gold linker is deprecated and has known bugs with Rust" --
# hundreds of lines per CI run, from a linker choice nothing here made. Pinning
# the toolchain links with lld instead, makes a local build and a CI build the
# same build, and is what rules_rs_mutants needs on macOS, where Xcode's
# cc_wrapper leaves a mutant link without `DEVELOPER_DIR`.
bazel_dep(name = "llvm", version = "0.8.18")

register_toolchains("@llvm//toolchain:all")

# ---------------------------------------------------------------------------
# Grafana-stack images for the container-driven suites.
#
# Pinned by digest and fetched by Bazel, so a test loads known bytes from the
# repository cache instead of pulling a mutable tag over the network mid-run.
# See //bazel/images, which turns each into a `docker load`-able tarball.
# ---------------------------------------------------------------------------
# `protoc` for the crates that generate prost types. Supplied by the build so
# no crate has to vendor a binary and locate it through its own manifest path.
#
# A prebuilt binary rather than the `protobuf` module, which builds protoc from
# its C++ sources -- minutes of compilation and several hundred deprecation
# warnings per CI run, for a tool the build only shells out to.
bazel_dep(name = "toolchains_protoc", version = "0.6.1")

# For the `@rules_proto//proto:toolchain_type` that `//bazel:protoc` resolves.
bazel_dep(name = "rules_proto", version = "7.1.0")

protoc = use_extension("@toolchains_protoc//protoc:extensions.bzl", "protoc")
protoc.toolchain(version = "v27.3")
use_repo(protoc, "toolchains_protoc_hub")

register_toolchains("@toolchains_protoc_hub//:all")

# rules_img owns pulled and assembled images. The application images start from
# locked Chainguard Wolfi packages assembled by apko, matching krabka-broker.
bazel_dep(name = "rules_img", version = "0.3.20")
bazel_dep(name = "rules_apko", version = "1.5.56")

# `sh_test`, for the wrapper that loads those images before a suite runs.
bazel_dep(name = "rules_shell", version = "0.8.0")

pull_image = use_repo_rule("@rules_img//img:pull.bzl", "pull")

[
    pull_image(
        name = name,
        digest = digest,
        layer_handling = "eager",
        registry = registry,
        repository = repository,
        tag = tag,
    )
    for name, registry, repository, tag, digest in [
        # The systems the differential suites compare against. Several of these
        # suites defaulted to `:latest`, which is the thing digest pinning
        # exists to remove: a differential test that disagrees with a moving
        # target reports a difference nobody changed.
        ("alloy", "mirror.gcr.io", "grafana/alloy", "v1.19.2", "sha256:1eeba15ef3193438c72f66efd3d76f769c523a4c661db0fae6eddde906004bc8"),
        ("alloy_previous", "mirror.gcr.io", "grafana/alloy", "v1.18.1", "sha256:754409730f1a4ed9781f8a2ea3b6a8c55750ee125a267ecf8fb449f9a25c109a"),
        ("grafana", "mirror.gcr.io", "grafana/grafana", "13.2.2", "sha256:9924c7fe0effe4a5fea08b3451905de54f09fde9d1589463a5f2d02d9ec158bc"),
        ("grafana_previous", "mirror.gcr.io", "grafana/grafana", "13.1.6", "sha256:66611512245b182e0928918b71db91fef25cb8f13d94f71fd2fb6253c383bb64"),
        ("loki", "mirror.gcr.io", "grafana/loki", "3.7.7", "sha256:550d599ec4efacd8ebc0a5871766855057cba2bd0c669c0711d898c00d6d901f"),
        ("mimir", "mirror.gcr.io", "grafana/mimir", "3.2.1", "sha256:d42bfba7a8ef82a14b883a4cf235406324aeecae94c85eba000bdaa21aa2f289"),
        # The object store the `scale` suites run against. Not a differential
        # oracle: nothing here compares an answer against MinIO. It is a real
        # S3 API in front of real storage, which is what makes a scale run
        # measure request counts, retries and multipart behaviour rather than
        # the behaviour of an in-process `InMemory` map.
        #
        # Pinned to a dated release rather than to whatever `latest` was.
        #
        # Served from `quay.io`, which is MinIO's own registry, not from
        # `mirror.gcr.io`. The mirror copies Docker Hub, MinIO stopped
        # publishing there after this release, and the mirror then served
        # neither the old digest nor `minio:latest` -- both 404. Every Bazel
        # invocation that analyses `//...` fetches this repository, so a cold
        # cache failed the lint, coverage and container-selection jobs at once
        # while a warm one carried on.
        #
        # The digest is unchanged, so this is the same image bytes from a
        # registry that still serves them.
        ("minio", "quay.io", "minio/minio", "RELEASE.2025-04-22T22-12-26Z", "sha256:3f97c5651cb6662b880c787a232b6b34fec8d8922e08d6617b25d241a21164bb"),
        ("prometheus", "mirror.gcr.io", "prom/prometheus", "v3.14.0", "sha256:e906cef998316bbe319f98711e1b4d8613ad37e14b08ff831d7036e77b7464f9"),
        ("prometheus_previous", "mirror.gcr.io", "prom/prometheus", "v3.13.3", "sha256:595c907995955f2d5fda19fae66392680921d9501cad0be5270b3fee959780b1"),
        ("pyroscope", "mirror.gcr.io", "grafana/pyroscope", "2.3.1", "sha256:718b585ea168a616ca737018dbd1676992db9e5f1084ec4e9cd18f669326f334"),
        ("tempo", "mirror.gcr.io", "grafana/tempo", "3.0.3", "sha256:05321ebf1f191fde34282b3dc86e68f511d489133df7963cd1670a2e1e11b33c"),
    ]
]

apko_toolchain = use_extension("@rules_apko//apko:extensions.bzl", "apko")
apko_toolchain.toolchain(apko_version = "v1.2.40")
use_repo(apko_toolchain, "apko_toolchains")

register_toolchains("@apko_toolchains//:all")

apk = use_extension("@rules_apko//apko:extensions.bzl", "apko")
apk.translate_lock(
    name = "o11y_base_lock",
    lock = "//bazel/images/krabka:base.apko.lock.json",
)
apk.translate_lock(
    name = "o11y_base_arm64_lock",
    lock = "//bazel/images/krabka:base.arm64.apko.lock.json",
)
use_repo(apk, "o11y_base_arm64_lock", "o11y_base_lock")

# ---------------------------------------------------------------------------
# Format and lint. See //tools/format and //tools/lint.
# ---------------------------------------------------------------------------
bazel_dep(name = "aspect_rules_lint", version = "2.7.2")

# Supplies a clippy aspect shaped the way `aspect lint` expects -- it writes the
# `rules_lint_machine` output group, which the aspect from @rules_rust does not.
# It also registers a Rust toolchain of its own, pinned to 1.92.0 / edition 2021
# for its own tests; see the toolchain block below for how the two coexist.
bazel_dep(name = "aspect_rules_lint_rust", version = "0.0.2")

# See the patch header: that module registers `@default_rust_toolchains//:all`,
# a package the rules_rs this repo resolves does not create.
single_version_override(
    module_name = "aspect_rules_lint_rust",
    patch_strip = 1,
    patches = ["//bazel/patches:aspect-rules-lint-rust-toolchain-pattern.patch"],
    version = "0.0.2",
)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3")

# rules_rs vends its own patched @rules_rust. `rust_doc_test` has no rules_rs
# wrapper, so it is loaded from there directly rather than from a second copy.
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

# ---------------------------------------------------------------------------
# Rust toolchain — pinned to the same channel as rust-toolchain.toml.
# ---------------------------------------------------------------------------
toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")

# Named rather than left as `default_rust_toolchains`, which
# aspect_rules_lint_rust also claims: rules_rs refuses two configurations under
# one repo name, and that module wants 1.92.0 / edition 2021 while this
# repository is 1.97.1 / edition 2024. Both toolchains get registered; ours is
# registered from the root module, which is what makes it the one that resolves.
toolchains.toolchain(
    name = "krabka_rust_toolchains",
    edition = "2024",
    # rustfmt.toml sets `format_code_in_doc_comments`, `group_imports` and
    # `imports_granularity`, all still nightly-gated. Stable rustfmt does not
    # fail on them, it warns and silently skips them -- so a stable formatter
    # would quietly disagree with the tree, which CI formats with
    # `cargo +nightly fmt`. rules_rs pins rustfmt separately from rustc for
    # exactly this.
    rustfmt_version = "nightly/2026-08-14",
    # Matches rust-toolchain.toml. These had drifted apart -- Bazel built with
    # 1.97.0 while Cargo used 1.97.1 -- which is precisely the split the "one
    # dependency source of truth" arrangement exists to avoid.
    version = "1.97.1",
)
use_repo(toolchains, "default_rust_toolchains", "krabka_rust_toolchains")

register_toolchains("@krabka_rust_toolchains//...")

# ---------------------------------------------------------------------------
# Native `-sys` crates, built by Bazel rather than by their build scripts.
#
# rules_rs ships a well-known annotation for each of these and warns on every
# build until it is applied. Each one otherwise compiles a bundled C library
# through a `cc`-crate build script: the host's compiler, its flags, and its
# headers, none of which the hermetic toolchain governs. Pointing them at the
# BCR's own builds puts that C under the same toolchain as everything else.
# ---------------------------------------------------------------------------
bazel_dep(name = "aws-lc", version = "5.1.0.bcr.2")
bazel_dep(name = "jemalloc", version = "5.3.0-bcr.alpha.4")
bazel_dep(name = "zstd", version = "1.5.7.bcr.1")

# aws-lc-sys' bindings are generated, and rules_rs prefers the pregenerated set
# to running bindgen; the toolchain is still required for the paths that do.
rules_rust_bindgen = use_extension("@rules_rs//rs:rules_rust_bindgen.bzl", "rules_rust_bindgen")
use_repo(rules_rust_bindgen, "rules_rust_bindgen")

register_toolchains("@rules_rust_bindgen//:all")

# ---------------------------------------------------------------------------
# Third-party crates, resolved from the Cargo workspace.
# ---------------------------------------------------------------------------
PLATFORM_TRIPLES = [
    "aarch64-apple-darwin",
    "aarch64-unknown-linux-gnu",
    "x86_64-apple-darwin",
    "x86_64-unknown-linux-gnu",
]

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = PLATFORM_TRIPLES,
)

# rules_rs_mutants deliberately ships no cargo-mutants binary: every consumer
# builds one from its own lockfile so the sweep and the build agree on a
# version. `//tools/mutants` is that lockfile.
crate.from_cargo(
    name = "mutants",
    cargo_lock = "//tools/mutants:Cargo.lock",
    cargo_toml = "//tools/mutants:Cargo.toml",
    platform_triples = PLATFORM_TRIPLES,
)

# The wire-layer and client crates come from two sibling repositories, each a
# Cargo workspace whose `members` is the glob `crates/*`. rules_rs resolves a git
# crate's directory by matching the crate name against the members list, and it
# skips glob entries, so each member's path is named here instead.
#
# tools/check-sibling-members.sh keeps this dict and the [patch.crates-io] table
# in Cargo.toml in step with the siblings at the pinned revisions.
SIBLING_MEMBERS = {
    "krabka-audit": "crates/audit",
    "krabka-authz": "crates/authz",
    "krabka-broker": "crates/broker",
    "krabka-client-admin": "crates/client-admin",
    "krabka-client-consumer": "crates/client-consumer",
    "krabka-client-coordination": "crates/client-coordination",
    "krabka-client-core": "crates/client-core",
    "krabka-client-producer": "crates/client-producer",
    "krabka-compression": "crates/compression",
    "krabka-ids": "crates/ids",
    "krabka-kraft-core": "crates/kraft-core",
    "krabka-log": "crates/log",
    "krabka-logfmt": "crates/logfmt",
    "krabka-metadata": "crates/metadata",
    "krabka-object-store": "crates/object-store",
    "krabka-raft": "crates/raft",
    "krabka-records-legacy": "crates/records-legacy",
    "krabka-remote-storage": "crates/remote-storage",
    "krabka-remote-storage-topic": "crates/remote-storage-topic",
    "krabka-schema-serde": "crates/schema-serde",
    "krabka-security": "crates/security",
    "krabka-telemetry": "crates/telemetry",
    "krabka-throttle": "crates/throttle",
    "krabka-trace-context": "crates/trace-context",
    "krabka-units": "crates/units",
    "krabka-verified": "crates/verified",
    "krabka-voters": "crates/voters",
}

[
    crate.annotation(
        crate = crate_name,
        strip_prefix = directory,
        workspace_cargo_toml = "Cargo.toml",
    )
    for crate_name, directory in SIBLING_MEMBERS.items()
]

# krabka-protocol carries the same member annotation plus one more. Its build.rs
# only checks that its checked-in `generated/`
# sources still match the `schemas/` SHAs; it emits no code. It reads its own
# manifest directory through `env!("CARGO_MANIFEST_DIR")`, which rules_rust
# rejects because it bakes an absolute build path into the binary. Nothing here
# needs the check -- the generated sources are consumed directly -- and the
# Cargo build in krabka-protocol still runs it.
crate.annotation(
    crate = "krabka-protocol",
    gen_build_script = "off",
    strip_prefix = "crates/protocol",
    workspace_cargo_toml = "Cargo.toml",
)

# datafusion-common's `test_util` locates datafusion's test-data submodule
# through `env!("CARGO_MANIFEST_DIR")`, and the module is not feature-gated, so
# that lands in every build of the library. `env!` bakes the absolute build
# directory into the artifact, which the sandboxed build rejects outright: the
# same sources would produce different bytes on different machines. The patch
# reads the variable at run time instead, which is where the only caller -- a
# test helper -- needs it, and which Cargo sets for test binaries anyway.
crate.annotation(
    crate = "datafusion-common",
    patch_args = ["-p1"],
    patches = ["//bazel/patches:datafusion-common-manifest-dir.patch"],
)
crate.annotation(
    crate = "cargo-mutants",
    gen_binaries = ["cargo-mutants"],
    repositories = ["mutants"],
)
crate.annotation(
    crate = "aws-lc-rs",
    gen_build_script = "off",
)
crate.annotation(
    additive_build_file = "@rules_rs//3rd_party/aws-lc-sys:additive.BUILD.bazel",
    crate = "aws-lc-sys",
    extra_aliased_targets = {"aws_lc_sys_build_info": "aws_lc_sys_build_info"},
    gen_build_script = "off",
    rustc_flags = ["--cfg=use_bindgen_pregenerated"],
    # One version resolves here, so the target needs no version suffix.
    deps = ["@crates//:aws_lc_sys_build_info"],
)
crate.annotation(
    crate = "tikv-jemalloc-sys",
    gen_build_script = "off",
    deps = ["@jemalloc"],
)
crate.annotation(
    crate = "zstd-sys",
    gen_build_script = "off",
    deps = ["@zstd"],
)
use_repo(crate, "crates", "mutants")

inject_repo(crate, "aws-lc")
