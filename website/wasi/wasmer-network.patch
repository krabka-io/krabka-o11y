+impl VirtualSocket for BrowserUdpSocket {
+    fn set_ttl(&mut self, ttl: u32) -> NetworkResult<()> {
+        self.ensure_open()?;
+        if ttl == 0 || ttl > 255 {
+            return Err(NetworkError::InvalidInput);
+        }
+        self.ttl = ttl;
+        Ok(())
+    }
+    fn ttl(&self) -> NetworkResult<u32> {
+        self.ensure_open().map(|()| self.ttl)
+    }
+    fn addr_local(&self) -> NetworkResult<SocketAddr> {
+        self.ensure_open().map(|()| self.addresses[0])
+    }
+    fn status(&self) -> NetworkResult<SocketStatus> {
+        Ok(
+            if self
+                .state
+                .lock()
+                .expect("browser UDP socket poisoned")
+                .closed
+            {
+                SocketStatus::Closed
+            } else {
+                SocketStatus::Opened
+            },
+        )
+    }
+    fn set_handler(
+        &mut self,
+        mut handler: Box<dyn InterestHandler + Send + Sync>,
+    ) -> NetworkResult<()> {
+        let mut state = self.state.lock().expect("browser UDP socket poisoned");
+        if state.closed || !state.queue.is_empty() {
+            handler.push_interest(InterestType::Readable);
+        }
+        if state.closed {
+            handler.push_interest(InterestType::Closed);
+        } else {
+            handler.push_interest(InterestType::Writable);
+        }
+        state.handler = Some(handler);
+        Ok(())
+    }
+}
