+    #[wasm_bindgen_test::wasm_bindgen_test]
+    async fn udp_receive_limits_readiness_and_network_close_are_real() {
+        use std::sync::atomic::{AtomicUsize, Ordering};
+        struct WakeCount(AtomicUsize);
+        impl std::task::Wake for WakeCount {
+            fn wake(self: Arc<Self>) {
+                self.0.fetch_add(1, Ordering::SeqCst);
+            }
+        }
+        let network = BrowserHttpNetworking::new();
+        let mut sender = network
+            .bind_udp("127.0.0.1:0".parse().unwrap(), false, false)
+            .await
+            .unwrap();
+        let mut receiver = network
+            .bind_udp("127.0.0.1:0".parse().unwrap(), false, false)
+            .await
+            .unwrap();
+        let target = receiver.addr_local().unwrap();
+        let wakes = Arc::new(WakeCount(AtomicUsize::new(0)));
+        let waker = Waker::from(wakes.clone());
+        let mut context = Context::from_waker(&waker);
+        assert!(receiver.poll_read_ready(&mut context).is_pending());
+        receiver
+            .set_handler(virtual_mio::WakerInterestHandler::new(&waker))
+            .unwrap();
+        wakes.0.store(0, Ordering::SeqCst);
+        sender.try_send_to(b"wake", target).unwrap();
+        assert!(wakes.0.load(Ordering::SeqCst) >= 2);
+        assert!(matches!(
+            receiver.poll_read_ready(&mut context),
+            Poll::Ready(Ok(4))
+        ));
+        assert_eq!(receive_packet(&mut *receiver, 4, false).0, b"wake");
+        let packet = vec![0x5a; 4096];
+        for _ in 0..UDP_QUEUE_BYTES / packet.len() + 1 {
+            sender.try_send_to(&packet, target).unwrap();
+        }
+        for _ in 0..UDP_QUEUE_BYTES / packet.len() {
+            assert_eq!(
+                receive_packet(&mut *receiver, packet.len(), false).0,
+                packet
+            );
+        }
+        assert!(matches!(
+            receiver.try_recv_from(&mut [], false),
+            Err(NetworkError::WouldBlock)
+        ));
+        for _ in 0..=UDP_QUEUE_PACKETS {
+            sender.try_send_to(b"", target).unwrap();
+        }
+        for _ in 0..UDP_QUEUE_PACKETS {
+            assert_eq!(receive_packet(&mut *receiver, 0, false).0.len(), 0);
+        }
+        assert!(matches!(
+            receiver.try_recv_from(&mut [], false),
+            Err(NetworkError::WouldBlock)
+        ));
+        assert!(matches!(
+            sender.try_send_to(&vec![0; MAX_SOCKET_PAYLOAD + 1], target),
+            Err(NetworkError::MessageSize)
+        ));
+        assert!(receiver.poll_read_ready(&mut context).is_pending());
+        wakes.0.store(0, Ordering::SeqCst);
+        network.request_handler().close();
+        assert!(wakes.0.load(Ordering::SeqCst) >= 2);
+        assert!(matches!(
+            receiver.poll_read_ready(&mut context),
+            Poll::Ready(Err(NetworkError::ConnectionAborted))
+        ));
+        assert!(matches!(
+            receiver.try_recv_from(&mut [], false),
+            Err(NetworkError::ConnectionAborted)
+        ));
+        assert!(matches!(
+            sender.try_send_to(b"closed", target),
+            Err(NetworkError::ConnectionAborted)
+        ));
+        assert!(matches!(
+            network.bind_udp(target, false, false).await,
+            Err(NetworkError::NotConnected)
+        ));
+    }
