+#[derive(Debug, Default)]
+struct DatagramState {
+    queue: VecDeque<(Bytes, SocketAddr)>,
+    queued_bytes: usize,
+    closed: bool,
+    handler: Option<Box<dyn InterestHandler + Send + Sync>>,
+    wakers: Vec<Waker>,
+}
+
+impl DatagramState {
+    fn close(&mut self) {
+        self.closed = true;
+        self.queue.clear();
+        self.queued_bytes = 0;
+        if let Some(handler) = self.handler.as_mut() {
+            handler.push_interest(InterestType::Readable);
+            handler.push_interest(InterestType::Closed);
+        }
+        for waker in self.wakers.drain(..) {
+            waker.wake();
+        }
+    }
+}
+
+#[derive(Debug)]
+struct BrowserUdpSocket {
+    networking: BrowserHttpNetworking,
+    state: Arc<Mutex<DatagramState>>,
+    addresses: Vec<SocketAddr>,
+    ttl: u32,
+}
+
+impl BrowserUdpSocket {
+    fn ensure_open(&self) -> NetworkResult<()> {
+        if self
+            .state
+            .lock()
+            .expect("browser UDP socket poisoned")
+            .closed
+        {
+            Err(NetworkError::ConnectionAborted)
+        } else {
+            Ok(())
+        }
+    }
+}
+
+impl Drop for BrowserUdpSocket {
+    fn drop(&mut self) {
+        self.state
+            .lock()
+            .expect("browser UDP socket poisoned")
+            .close();
+        let mut network = self
+            .networking
+            .state
+            .lock()
+            .expect("browser UDP network poisoned");
+        for address in &self.addresses {
+            if network
+                .datagrams
+                .get(address)
+                .and_then(Weak::upgrade)
+                .is_some_and(|socket| Arc::ptr_eq(&socket, &self.state))
+            {
+                network.datagrams.remove(address);
+            }
+        }
+    }
+}
