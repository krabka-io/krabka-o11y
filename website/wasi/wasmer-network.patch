+fn allocate_address(
+    state: &mut NetworkState,
+    mut address: SocketAddr,
+    available: impl Fn(&NetworkState, SocketAddr) -> bool,
+) -> NetworkResult<SocketAddr> {
+    if address.port() != 0 {
+        return if available(state, address) {
+            Ok(address)
+        } else {
+            Err(NetworkError::AddressInUse)
+        };
+    }
+    for _ in EPHEMERAL_PORT_START..=u16::MAX {
+        let port = state.next_port.max(EPHEMERAL_PORT_START);
+        state.next_port = if port == u16::MAX {
+            EPHEMERAL_PORT_START
+        } else {
+            port + 1
+        };
+        address.set_port(port);
+        if available(state, address) {
+            return Ok(address);
+        }
+    }
+    Err(NetworkError::AddressInUse)
+}
