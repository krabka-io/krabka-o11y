+impl VirtualConnectionlessSocket for BrowserUdpSocket {
+    fn try_send_to(&mut self, data: &[u8], peer: SocketAddr) -> NetworkResult<usize> {
+        self.ensure_open()?;
+        if data.len() > MAX_SOCKET_PAYLOAD {
+            return Err(NetworkError::MessageSize);
+        }
+        if peer.port() == 0 {
+            return Err(NetworkError::InvalidInput);
+        }
+        if !peer.ip().is_loopback() && !peer.ip().is_unspecified() {
+            return Err(NetworkError::Unsupported);
+        }
+        let source = self
+            .addresses
+            .iter()
+            .copied()
+            .find(|address| address.is_ipv4() == peer.is_ipv4())
+            .ok_or(NetworkError::InvalidInput)?;
+        let Some(receiver) = self.networking.datagram_peer(peer)? else {
+            // UDP does not acknowledge delivery to an unbound destination.
+            return Ok(data.len());
+        };
+        let mut state = receiver.lock().expect("browser UDP socket poisoned");
+        if state.closed {
+            return Err(NetworkError::ConnectionAborted);
+        }
+        // ponytail: bounded receive queue drops excess UDP packets, as a full OS receive buffer does.
+        if state.queue.len() >= UDP_QUEUE_PACKETS
+            || state.queued_bytes + data.len() > UDP_QUEUE_BYTES
+        {
+            return Ok(data.len());
+        }
+        state.queued_bytes += data.len();
+        state
+            .queue
+            .push_back((Bytes::copy_from_slice(data), source));
+        if let Some(handler) = state.handler.as_mut() {
+            handler.push_interest(InterestType::Readable);
+        }
+        for waker in state.wakers.drain(..) {
+            waker.wake();
+        }
+        Ok(data.len())
+    }
+
+    fn try_recv_from(
+        &mut self,
+        buf: &mut [MaybeUninit<u8>],
+        peek: bool,
+    ) -> NetworkResult<(usize, SocketAddr)> {
+        let mut state = self.state.lock().expect("browser UDP socket poisoned");
+        if state.closed {
+            return Err(NetworkError::ConnectionAborted);
+        }
+        let (data, peer) = state.queue.front().ok_or(NetworkError::WouldBlock)?;
+        let received = (buf.len().min(data.len()), *peer);
+        for (destination, byte) in buf.iter_mut().zip(data.iter()) {
+            destination.write(*byte);
+        }
+        if !peek {
+            let packet = state.queue.pop_front().expect("datagram exists");
+            state.queued_bytes -= packet.0.len();
+        }
+        Ok(received)
+    }
+}
