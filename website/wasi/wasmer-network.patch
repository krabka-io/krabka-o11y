+fn tcp_address_available(state: &NetworkState, address: SocketAddr, only_v6: bool) -> bool {
+    listener_addresses(address, only_v6).iter().all(|address| {
+        !state.bound.contains(address)
+            && !state
+                .listeners
+                .get(address)
+                .is_some_and(|listener| listener.strong_count() > 0)
+    })
+}
