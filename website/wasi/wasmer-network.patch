+    #[wasm_bindgen_test::wasm_bindgen_test]
+    async fn tcp_port_zero_skips_bound_and_listener_ports_and_wraps() {
+        let network = BrowserHttpNetworking::new();
+        let mut first = network
+            .bind_tcp("0.0.0.0:0".parse().unwrap(), false, false, false)
+            .await
+            .unwrap();
+        let first_address = first.addr_local().unwrap();
+        let mut listener = first.listen().unwrap();
+        let second = network
+            .bind_tcp("[::]:0".parse().unwrap(), false, false, false)
+            .await
+            .unwrap();
+        assert_ne!(first_address.port(), 0);
+        assert_ne!(second.addr_local().unwrap().port(), first_address.port());
+        network.state.lock().unwrap().next_port = first_address.port();
+        let third = network
+            .bind_tcp("127.0.0.1:0".parse().unwrap(), false, false, false)
+            .await
+            .unwrap();
+        assert_ne!(third.addr_local().unwrap().port(), first_address.port());
+        assert_ne!(
+            third.addr_local().unwrap().port(),
+            second.addr_local().unwrap().port()
+        );
+        let socket = network
+            .connect_tcp("127.0.0.1:0".parse().unwrap(), first_address)
+            .await
+            .unwrap();
+        assert_eq!(
+            listener.try_accept().unwrap().1,
+            socket.addr_local().unwrap()
+        );
+        assert_ne!(
+            socket.addr_local().unwrap().port(),
+            third.addr_local().unwrap().port()
+        );
+        let network = BrowserHttpNetworking::new();
+        let last = network
+            .bind_tcp("127.0.0.1:65535".parse().unwrap(), false, false, false)
+            .await
+            .unwrap();
+        let _first = network
+            .bind_tcp("127.0.0.1:49152".parse().unwrap(), false, false, false)
+            .await
+            .unwrap();
+        network.state.lock().unwrap().next_port = u16::MAX;
+        assert_eq!(
+            network
+                .bind_tcp("127.0.0.1:0".parse().unwrap(), false, false, false)
+                .await
+                .unwrap()
+                .addr_local()
+                .unwrap()
+                .port(),
+            49153
+        );
+        drop(last);
+        network.state.lock().unwrap().next_port = u16::MAX;
+        assert_eq!(
+            network
+                .bind_tcp("127.0.0.1:0".parse().unwrap(), false, false, false)
+                .await
+                .unwrap()
+                .addr_local()
+                .unwrap()
+                .port(),
+            u16::MAX
+        );
+        // Exhaust the address ledger independently; bind(0) must terminate with EADDRINUSE.
+        network.state.lock().unwrap().bound.extend(
+            (EPHEMERAL_PORT_START..=u16::MAX)
+                .map(|port| SocketAddr::new(Ipv4Addr::LOCALHOST.into(), port)),
+        );
+        assert!(matches!(
+            network
+                .bind_tcp("127.0.0.1:0".parse().unwrap(), false, false, false)
+                .await,
+            Err(NetworkError::AddressInUse)
+        ));
+    }

