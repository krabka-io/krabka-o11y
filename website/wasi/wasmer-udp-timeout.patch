+    #[cfg(all(feature = "sys", feature = "host-vnet"))]
+    #[tokio::test(flavor = "current_thread")]
+    async fn inode_socket_udp_timeout_preserves_options_and_expires_real_receive() {
+        use super::TimeType;
+
+        let tasks = crate::runtime::task_manager::tokio::TokioTaskManager::default();
+        let net = virtual_net::host::LocalNetworking::new();
+        let local = SocketAddr::from((Ipv4Addr::LOCALHOST, 0));
+        for remote in [false, true] {
+            let props = SocketProperties {
+                family: Addressfamily::Inet4,
+                ty: Socktype::Dgram,
+                pt: SockProto::Udp,
+                only_v6: false,
+                reuse_port: false,
+                reuse_addr: false,
+                no_delay: None,
+                keep_alive: None,
+                dont_route: None,
+                send_buf_size: None,
+                recv_buf_size: None,
+                write_timeout: None,
+                read_timeout: None,
+                accept_timeout: None,
+                connect_timeout: None,
+                handler: None,
+            };
+            let inode = InodeSocket::new(if remote {
+                InodeSocketKind::RemoteSocket {
+                    props,
+                    local_addr: local,
+                    peer_addr: local,
+                    ttl: 64,
+                    multicast_ttl: 1,
+                    is_dead: false,
+                }
+            } else {
+                InodeSocketKind::PreSocket { props, addr: None }
+            });
+            let read_timeout = Some(Duration::from_millis(20));
+            let write_timeout = Some(Duration::from_millis(50));
+            inode
+                .set_opt_time(TimeType::ReadTimeout, read_timeout)
+                .unwrap();
+            inode
+                .set_opt_time(TimeType::WriteTimeout, write_timeout)
+                .unwrap();
+            let bound = inode.bind(&tasks, &net, local).await.unwrap().unwrap();
+            assert_ne!(bound.addr_local().unwrap().port(), 0);
+            assert_eq!(bound.opt_time(TimeType::ReadTimeout).unwrap(), read_timeout);
+            assert_eq!(
+                bound.opt_time(TimeType::WriteTimeout).unwrap(),
+                write_timeout
+            );
+
+            // Options are shared by descriptor clones, and can be cleared after bind.
+            let clone = bound.clone();
+            clone.set_opt_time(TimeType::ReadTimeout, None).unwrap();
+            assert_eq!(bound.opt_time(TimeType::ReadTimeout).unwrap(), None);
+            bound
+                .set_opt_time(TimeType::ReadTimeout, read_timeout)
+                .unwrap();
+            clone.set_opt_time(TimeType::WriteTimeout, None).unwrap();
+            assert_eq!(bound.opt_time(TimeType::WriteTimeout).unwrap(), None);
+            bound
+                .set_opt_time(TimeType::WriteTimeout, write_timeout)
+                .unwrap();
+            assert_eq!(
+                bound.set_opt_time(TimeType::AcceptTimeout, read_timeout),
+                Err(Errno::Inval)
+            );
+
+            // An empty native UDP socket must expire through the actual receiver poller.
+            let mut buf = [MaybeUninit::uninit(); 64];
+            let timed_out = tokio::time::timeout(
+                Duration::from_secs(2),
+                bound.recv_from(
+                    &tasks,
+                    &mut buf,
+                    bound.opt_time(TimeType::ReadTimeout).unwrap(),
+                    false,
+                    false,
+                ),
+            )
+            .await
+            .expect("UDP receive ignored its configured deadline");
+            assert_eq!(timed_out, Err(Errno::Timedout));
+
+            // Timeout cancellation must leave the socket and readiness handler usable.
+            let sender = std::net::UdpSocket::bind(local).unwrap();
+            let payload = b"receive after timeout";
+            sender
+                .send_to(payload, bound.addr_local().unwrap())
+                .unwrap();
+            let (received, peer) = bound
+                .recv_from(&tasks, &mut buf, Some(Duration::from_secs(2)), false, false)
+                .await
+                .unwrap();
+            assert_eq!(peer, sender.local_addr().unwrap());
+            assert_eq!(received, payload.len());
+            let bytes: Vec<_> = buf[..received]
+                .iter()
+                .map(|byte| unsafe { byte.assume_init() })
+                .collect();
+            assert_eq!(bytes, payload);
+        }
+    }
