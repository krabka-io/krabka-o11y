+#[cfg(all(test, target_vendor = "wasmer"))]
+mod owned_file_tests {
+    use super::{map_file, File, Seek, SeekFrom};
+
+    #[test]
+    fn owned_file_view_reads_real_bytes_from_the_start() -> std::io::Result<()> {
+        let path = std::env::temp_dir().join(format!(
+            "addr2line-owned-view-{}.bin",
+            std::process::id(),
+        ));
+        let expected = [0, 255, 127, 69, 76, 70];
+        std::fs::write(&path, expected)?;
+        let file = File::open(&path)?;
+        let mut cursor = &file;
+        cursor.seek(SeekFrom::Start(3))?;
+        let data = map_file(&file)?;
+        std::fs::remove_file(&path)?;
+        if data.as_slice() != expected.as_slice() {
+            return Err(std::io::Error::other("owned file view changed the bytes"));
+        }
+        Ok(())
+    }
