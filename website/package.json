{
  "name": "krabka-o11y-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-site.mjs && astro dev --host 127.0.0.1",
    "build:site": "node scripts/prepare-site.mjs && astro build",
    "build:lab": "bash scripts/build-lab.sh",
    "build": "npm run build:lab && npm run build:site",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test scripts/*.test.mjs",
    "check": "node scripts/check-site.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.5",
    "@wasmer/sdk": "0.19.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
