"""Images the differential suites run against.

Pulled by Bazel from a digest and loaded into the local daemon at test time,
rather than pulled by testcontainers over the network mid-test. That pins the
bytes a test runs against, keeps the network out of the test itself, and lets
the repository cache carry the images between CI runs.

`image_load` produces a `docker load`-able tarball; `//bazel:docker_test.sh` loads
each one it is handed before executing the test binary.
"""

load("@rules_img//img:load.bzl", "image_load")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":images.bzl", "CLIENTS", "IMAGES", "ORACLES")

package(default_visibility = ["//visibility:public"])

[
    image_load(
        name = name,
        image = "@" + name,
        tag = tag,
        tags = ["docker"],
    )
    for name, tag in IMAGES.items()
]

# The tarball each `image_load` produces, which is what a test consumes.
[
    filegroup(
        name = name + "_tar",
        srcs = [":" + name],
        output_group = "tarball",
        tags = ["docker"],
    )
    for name in IMAGES
]

[
    sh_test(
        name = name + "_version_test",
        size = "small",
        srcs = ["oracle_version_test.sh"],
        args = [
            "$(rootpath :%s_tar)" % name,
            oracle.image,
            oracle.binary,
            oracle.image.rsplit(":", 1)[1],
            oracle.revision,
        ],
        data = [":" + name + "_tar"],
        tags = [
            "docker",
            "external",
            "no-sandbox",
        ],
    )
    for name, oracle in ORACLES.items()
]

[
    sh_test(
        name = name + "_version_test",
        size = "small",
        srcs = ["client_version_test.sh"],
        args = [
            "$(rootpath :%s_tar)" % name,
            client.image,
            client.binary,
            client.version,
            client.revision,
        ],
        data = [":" + name + "_tar"],
        tags = [
            "docker",
            "external",
            "no-sandbox",
        ],
    )
    for name, client in CLIENTS.items()
]
