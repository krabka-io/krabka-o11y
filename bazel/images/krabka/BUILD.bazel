"""The krabka-o11y application image.

apko assembles locked Chainguard Wolfi bases for each CPU architecture.
rules_img adds the Bazel-built binaries and owns local loading, release indexes
and registry delivery. The same platform-aware manifest target is used for both
architectures so their contents cannot drift.
"""

load("@rules_apko//apko:defs.bzl", "apko_image")
load("@rules_img//img:convert.bzl", "image_manifest_from_oci_layout")
load("@rules_img//img:image.bzl", "image_index", "image_manifest")
load("@rules_img//img:layer.bzl", "file_metadata", "image_layer")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:media_types.bzl", "GZIP_LAYER")
load("@rules_img//img:push.bzl", "image_push")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

apko_image(
    name = "base_oci",
    config = "base.apko.yaml",
    contents = "@o11y_base_lock//:contents",
    tag = "krabka-o11y-base:amd64-locked",
)

apko_image(
    name = "base_arm64_oci",
    config = "base.arm64.apko.yaml",
    contents = "@o11y_base_arm64_lock//:contents",
    tag = "krabka-o11y-base:arm64-locked",
)

image_manifest_from_oci_layout(
    name = "base",
    src = ":base_oci",
    architecture = "amd64",
    layers = [GZIP_LAYER],
    os = "linux",
)

image_manifest_from_oci_layout(
    name = "base_arm64",
    src = ":base_arm64_oci",
    architecture = "arm64",
    layers = [GZIP_LAYER],
    os = "linux",
)

NONROOT = file_metadata(
    gid = 65532,
    mode = "0755",
    uid = 65532,
)

BINARIES = {
    "/usr/local/bin/krabka-metrics": "//crates/metrics:krabka-metrics",
    "/usr/local/bin/krabka-metrics-service": "//crates/metrics-service:krabka-metrics-service",
    "/usr/local/bin/krabka-o11y-bootstrap": "//crates/observability:krabka-o11y-bootstrap",
    "/usr/local/bin/krabka-observability": "//crates/observability:krabka-observability",
    "/usr/local/bin/krabka-profiles": "//crates/profiles:krabka-profiles",
    "/usr/local/bin/krabka-traces": "//crates/traces:krabka-traces",
}

image_layer(
    name = "binaries_layer",
    srcs = BINARIES,
    default_metadata = NONROOT,
    include_runfiles = False,
)

image_manifest(
    name = "image",
    base = select({
        ":linux_arm64": ":base_arm64",
        "//conditions:default": ":base",
    }),
    entrypoint = [],
    labels = {
        "org.opencontainers.image.description": "The krabka observability stack: metrics, traces, profiles and logs",
        "org.opencontainers.image.licenses": "Apache-2.0",
        "org.opencontainers.image.source": "https://github.com/krabka-io/krabka-o11y",
        "org.opencontainers.image.title": "krabka-o11y",
        "org.opencontainers.image.url": "https://github.com/krabka-io/krabka-o11y",
    },
    layers = [":binaries_layer"],
    target_compatible_with = ["@platforms//os:linux"],
    user = "65532:65532",
    working_dir = "/var/lib/krabka",
)

filegroup(
    name = "image_manifest_blob",
    srcs = [":image"],
    output_group = "root_blob",
)

# This target is built only by a v* release workflow. The split transition
# builds `image` once for each platform and writes one OCI image index.
image_index(
    name = "image_multiarch",
    manifests = [":image"],
    platforms = [
        "//:linux_amd64",
        "//:linux_arm64",
    ],
    tags = ["manual"],
)

filegroup(
    name = "image_multiarch_index_blob",
    srcs = [":image_multiarch"],
    output_group = "root_blob",
    tags = ["manual"],
)

image_load(
    name = "load",
    image = ":image",
    tag = "krabka-o11y:dev",
)

image_push(
    name = "push",
    image = ":image",
    registry = "ghcr.io",
    repository = "krabka-io/krabka-o11y",
    tags = ["manual"],
)

image_push(
    name = "push_multiarch",
    image = ":image_multiarch",
    registry = "ghcr.io",
    repository = "krabka-io/krabka-o11y",
    tags = ["manual"],
)
